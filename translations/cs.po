#: __init__.py:32
msgid ""
"UI plugin to Check for Duplicate/Missing/Added Books when Ejecting Devices."
msgstr "Modul uživatelského rozhraní pro kontrolu duplicitních, chybějících a přidaných knih při vysouvání zařízení."

#: config.py:116
msgid "Basic"
msgstr "Základní"

#: config.py:119
msgid "Searches"
msgstr "Hledání"

#: config.py:157
msgid "When Ejecting a Device, Check for:"
msgstr "Při vysouvání zařízení kontrolovat:"

#: config.py:171
msgid "Reading Lists to Sync TO device"
msgstr "Seznamy ke čtení k synchronizaci do zařízení"

#: config.py:172
msgid ""
"Check Reading List plugin for books ready to Sync to the current device."
msgstr "Zkontrolovat modul Reading List, jestli obsahuje knihy připravené k synchronizaci do aktuálního zařízení."

#: config.py:177
msgid "Reading Lists to Sync FROM device"
msgstr "Seznamy ke čtení k synchronizaci ze zařízení"

#: config.py:178
msgid ""
"Check Reading List plugin for lists that auto populate from device and call "
"Sync Now."
msgstr "Zkontrolovat modul Reading List, jestli obsahuje seznamy automaticky naplňované ze zařízení, a spustit akci Synchronizovat nyní."

#: config.py:182
msgid "Sync Silently?"
msgstr "Synchronizovat bez dotazu?"

#: config.py:183
msgid ""
"Don't ask each time before calling Reading List's Sync Now--only applies to "
"FROM device lists."
msgstr "Neptat se pokaždé před spuštěním akce Synchronizovat nyní modulu Reading List. Platí jen pro seznamy ze zařízení."

#: config.py:198
msgid "Duplicated Books"
msgstr "Duplicitní knihy"

#: config.py:199
msgid "Check for books that are on the device more than once."
msgstr "Kontrolovat knihy, které jsou v zařízení více než jednou."

#: config.py:203
msgid "Delete from Device?"
msgstr "Odstranit ze zařízení?"

#: config.py:204
msgid "Open Delete dialog for duplicated books on device."
msgstr "Otevřít dialog odstranění duplicitních knih v zařízení."

#: config.py:213
msgid "Deleted Books (not in Library)"
msgstr "Odstraněné knihy (nejsou v knihovně)"

#: config.py:214
msgid "Check for books on the device that are not in the current library."
msgstr "Kontrolovat knihy v zařízení, které nejsou v aktuální knihovně."

#: config.py:218
msgid "Deleted from Device?"
msgstr "Odstranit ze zařízení?"

#: config.py:219
msgid "Delete books on the device that are not in the current library."
msgstr "Odstranit ze zařízení knihy, které nejsou v aktuální knihovně."

#: config.py:229
msgid "Added Books (not on Device)"
msgstr "Přidané knihy (nejsou v zařízení)"

#: config.py:230
msgid "Check for books in the current library that are not on the device."
msgstr "Kontrolovat knihy v aktuální knihovně, které nejsou v zařízení."

#: config.py:234
msgid "Send to Device?"
msgstr "Odeslat do zařízení?"

#: config.py:235
msgid "Send books in the current library that are not on the device."
msgstr "Odeslat do zařízení knihy z aktuální knihovny, které v zařízení nejsou."

#: config.py:244
msgid "Stop wireless device connection"
msgstr "Ukončit připojení bezdrátového zařízení"

#: config.py:245
msgid ""
"If ejecting a wireless device, also stop the wireless device connection."
msgstr "Při vysouvání bezdrátového zařízení také ukončit připojení bezdrátového zařízení."

#: config.py:253
msgid ""
"These controls aren't plugin settings as such, but convenience buttons for "
"setting Keyboard shortcuts and viewing all plugins settings."
msgstr "Tyto ovládací prvky samy o sobě nejsou nastavením modulu, ale praktickými tlačítky pro nastavení klávesových zkratek a zobrazení všech nastavení modulu."

#: config.py:258
msgid "Keyboard shortcuts..."
msgstr "Klávesové zkratky..."

#: config.py:259
msgid "Edit the keyboard shortcuts associated with this plugin"
msgstr "Upravit klávesové zkratky přiřazené tomuto modulu"

#: config.py:263
msgid "&View library preferences..."
msgstr "&Zobrazit předvolby knihovny..."

#: config.py:264
msgid "View data stored in the library database for this plugin"
msgstr "Zobrazit data tohoto modulu uložená v databázi knihovny"

#: config.py:277
msgid "Done"
msgstr "Hotovo"

#: config.py:278
msgid "Confirmation dialogs have all been reset"
msgstr "Všechny potvrzovací dialogy byly resetovány"

#: config.py:292
msgid "Searches to use for:"
msgstr "Vyhledávací výrazy používané pro:"

#: config.py:307
msgid "Search for Duplicated Books:"
msgstr "Vyhledávací výraz pro duplicitní knihy:"

#: config.py:315 config.py:322 config.py:329
msgid "Default is %s"
msgstr "Výchozí hodnota je %s"

#: config.py:318
msgid "Deleted Books (not in Library):"
msgstr "Odstraněné knihy (nejsou v knihovně):"

#: config.py:325
msgid "Added Books (not on Device):"
msgstr "Přidané knihy (nejsou v zařízení):"

#: config.py:335
msgid "Restore Defaults"
msgstr "Obnovit výchozí nastavení"

#: config.py:336
msgid "Revert all searches to the defaults."
msgstr "Vrátit všechny vyhledávací výrazy na výchozí hodnoty."

#: smarteject_plugin.py:36 smarteject_plugin.py:69
msgid "SmartEject"
msgstr "SmartEject"

#: smarteject_plugin.py:37
msgid "Check for duplicated/deleted/added books before ejecting."
msgstr "Před vysunutím zařízení zkontrolovat duplicitní, odstraněné a přidané knihy."

#: smarteject_plugin.py:97
msgid "Sync Reading List?"
msgstr "Synchronizovat modul Reading List?"

#: smarteject_plugin.py:97
msgid ""
"There are books that need syncing according to Reading List.<p>Sync Books?"
msgstr "Modul Reading List hlásí knihy, které je potřeba synchronizovat.<p>Synchronizovat knihy?"

#: smarteject_plugin.py:101
msgid "Sync Now Reading List?"
msgstr "Spustit akci Synchronizovat nyní v modulu Reading List?"

#: smarteject_plugin.py:101
msgid ""
"There are lists that could be sync'ed according to Reading List.<p>Sync "
"before ejecting?"
msgstr "Modul Reading List hlásí seznamy, které lze synchronizovat.<p>Synchronizovat před vysunutím?"

#: smarteject_plugin.py:115
msgid ""
"There are duplicate ebooks on the device.<p>Delete duplicates?  (Make sure "
"you uncheck the ones you want to keep)."
msgstr "V zařízení jsou duplicitní e-knihy.<p>Odstranit duplicity? (Nezapomeňte zrušit zaškrtnutí u těch, které chcete zachovat.)"

#: smarteject_plugin.py:117
msgid "There are duplicate ebooks on the device.<p>Display duplicates?"
msgstr "V zařízení jsou duplicitní e-knihy.<p>Zobrazit duplicity?"

#: smarteject_plugin.py:118
msgid "Duplicates on Device"
msgstr "Duplicity v zařízení"

#: smarteject_plugin.py:138
msgid ""
"There are books on the device in %s that are not in the Library.<p>Delete "
"books not in Library?"
msgstr "V umístění %s v zařízení jsou knihy, které nejsou v knihovně.<p>Odstranit knihy, které nejsou v knihovně?"

#: smarteject_plugin.py:140
msgid ""
"There are books on the device in %s that are not in the Library.<p>Display "
"books not in Library?"
msgstr "V umístění %s v zařízení jsou knihy, které nejsou v knihovně.<p>Zobrazit knihy, které nejsou v knihovně?"

#: smarteject_plugin.py:141
msgid "Books on Device not in Library"
msgstr "Knihy v zařízení, které nejsou v knihovně"

#: smarteject_plugin.py:158
msgid ""
"There are books in the Library that are not on the Device.<p>Send books not "
"on Device?"
msgstr "V knihovně jsou knihy, které nejsou v zařízení.<p>Odeslat tyto knihy do zařízení?"

#: smarteject_plugin.py:160
msgid ""
"There are books in the Library that are not on the Device.<p>Display books "
"not on Device?"
msgstr "V knihovně jsou knihy, které nejsou v zařízení.<p>Zobrazit knihy, které nejsou v zařízení?"

#: smarteject_plugin.py:162
msgid "Books in Library not on Device"
msgstr "Knihy v knihovně, které nejsou v zařízení"
