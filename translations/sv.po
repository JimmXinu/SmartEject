#: __init__.py:32
msgid ""
"UI plugin to Check for Duplicate/Missing/Added Books when Ejecting Devices."
msgstr "Plugin avsett för att söka och jämföra bibliotek efter dubbletter, borttagningar och tillagda böcker vid utmatning av enheter."

#: config.py:116
msgid "Basic"
msgstr "Grundläggande"

#: config.py:119
msgid "Searches"
msgstr "Sökningar"

#: config.py:157
msgid "When Ejecting a Device, Check for:"
msgstr "När enheter kopplas bort, genomsök efter:"

#: config.py:171
msgid "Reading Lists to Sync TO device"
msgstr "Läslistor som ska synkroniseras TILL enheten"

#: config.py:172
msgid ""
"Check Reading List plugin for books ready to Sync to the current device."
msgstr "Undersök läslista efter böcker som är redo att synkroniseras till aktuell enhet."

#: config.py:177
msgid "Reading Lists to Sync FROM device"
msgstr "Läslistor som ska synkroniseras FRÅN enheten"

#: config.py:178
msgid ""
"Check Reading List plugin for lists that auto populate from device and call "
"Sync Now."
msgstr "Kontrollera om insticksprogrammet Reading List har listor som fylls i automatiskt från enheten och kör Synkronisera nu."

#: config.py:182
msgid "Sync Silently?"
msgstr "Synkronisera utan frågor?"

#: config.py:183
msgid ""
"Don't ask each time before calling Reading List's Sync Now--only applies to "
"FROM device lists."
msgstr "Fråga inte varje gång innan Reading Lists funktion Synkronisera nu körs – gäller endast listor som synkroniseras FRÅN enheten."

#: config.py:198
msgid "Duplicated Books"
msgstr "Duplicerade böcker"

#: config.py:199
msgid "Check for books that are on the device more than once."
msgstr "Söker efter böcker som finns mer än en gång på enheten."

#: config.py:203
msgid "Delete from Device?"
msgstr "Ta bort från enhet?"

#: config.py:204
msgid "Open Delete dialog for duplicated books on device."
msgstr "Öppna dialogrutan Ta bort för dubblettböcker på enheten."

#: config.py:213
msgid "Deleted Books (not in Library)"
msgstr "Ta bort böcker (inte i bibliotektet)"

#: config.py:214
msgid "Check for books on the device that are not in the current library."
msgstr "Söker efter böcker på enheten som inte finns i aktuellt bibliotek."

#: config.py:218
msgid "Deleted from Device?"
msgstr "Borttagen från enhet?"

#: config.py:219
msgid "Delete books on the device that are not in the current library."
msgstr "Ta bort böcker på enheten som inte finns i det aktuella biblioteket."

#: config.py:229
msgid "Added Books (not on Device)"
msgstr "Tillagda böcker (inte på enhet)"

#: config.py:230
msgid "Check for books in the current library that are not on the device."
msgstr "Sök efter böcker i aktuellt bibliotek som inte finns på enheten."

#: config.py:234
msgid "Send to Device?"
msgstr "Skicka till enhet?"

#: config.py:235
msgid "Send books in the current library that are not on the device."
msgstr "Skicka böcker i det aktuella biblioteket som inte finns på enheten."

#: config.py:244
msgid "Stop wireless device connection"
msgstr "Stoppa anslutningen till den trådlösa enheten"

#: config.py:245
msgid ""
"If ejecting a wireless device, also stop the wireless device connection."
msgstr "Stoppa även anslutningen till den trådlösa enheten när en trådlös enhet matas ut."

#: config.py:253
msgid ""
"These controls aren't plugin settings as such, but convenience buttons for "
"setting Keyboard shortcuts and viewing all plugins settings."
msgstr "Dessa kontroller är inte inställningar för insticksprogrammet som sådant, men är bekväma knappar för att ställa in tangentbordssnabbbval och visa alla inställningar."

#: config.py:258
msgid "Keyboard shortcuts..."
msgstr "Tangentbordssnabbval..."

#: config.py:259
msgid "Edit the keyboard shortcuts associated with this plugin"
msgstr "Redigera tangentbordssnabbval som är associerade med detta insticksprogram"

#: config.py:263
msgid "&View library preferences..."
msgstr "&Visa biblioteksval..."

#: config.py:264
msgid "View data stored in the library database for this plugin"
msgstr "Visa data lagrat i biblioteksdatabasen för detta insticksprogram"

#: config.py:277
msgid "Done"
msgstr "Klar"

#: config.py:278
msgid "Confirmation dialogs have all been reset"
msgstr "Bonfirmationsdialogrutor har alla blivit nollställda"

#: config.py:292
msgid "Searches to use for:"
msgstr "Sökningar att användas för:"

#: config.py:307
msgid "Search for Duplicated Books:"
msgstr "Sökning av duplicerade böcker:"

#: config.py:315 config.py:322 config.py:329
msgid "Default is %s"
msgstr "Grundinställning är %s"

#: config.py:318
msgid "Deleted Books (not in Library):"
msgstr "Borttagna böcker (in i bibliotek):"

#: config.py:325
msgid "Added Books (not on Device):"
msgstr "Tillagda böcker (inte på enhet):"

#: config.py:335
msgid "Restore Defaults"
msgstr "Återställ grundinställning"

#: config.py:336
msgid "Revert all searches to the defaults."
msgstr "Återställ alla sökningar till grundinställningar."

#: smarteject_plugin.py:36 smarteject_plugin.py:69
msgid "SmartEject"
msgstr "Smart borttagning"

#: smarteject_plugin.py:37
msgid "Check for duplicated/deleted/added books before ejecting."
msgstr "Sök efter duplikat/borttagna/tillagda böcker före borttagning."

#: smarteject_plugin.py:97
msgid "Sync Reading List?"
msgstr "Synkronisera läslista?"

#: smarteject_plugin.py:97
msgid ""
"There are books that need syncing according to Reading List.<p>Sync Books?"
msgstr "Det finns böcker som behöver synkroniseras enligt läslista. <p>Synkronisera böcker?"

#: smarteject_plugin.py:101
msgid "Sync Now Reading List?"
msgstr "Synkronisera Reading List nu?"

#: smarteject_plugin.py:101
msgid ""
"There are lists that could be sync'ed according to Reading List.<p>Sync "
"before ejecting?"
msgstr "Enligt Reading List finns det listor som kan synkroniseras.<p>Synkronisera före utmatning?"

#: smarteject_plugin.py:115
msgid ""
"There are duplicate ebooks on the device.<p>Delete duplicates?  (Make sure "
"you uncheck the ones you want to keep)."
msgstr "Det finns dubbletter av e-böcker på enheten.<p>Ta bort dubbletterna? (Avmarkera de böcker som du vill behålla.)"

#: smarteject_plugin.py:117
msgid "There are duplicate ebooks on the device.<p>Display duplicates?"
msgstr "Det finns duplicerade e-böcker på enheten. <p>Visa duplikat?"

#: smarteject_plugin.py:118
msgid "Duplicates on Device"
msgstr "Duplikat på enhet"

#: smarteject_plugin.py:138
msgid ""
"There are books on the device in %s that are not in the Library.<p>Delete "
"books not in Library?"
msgstr "Det finns böcker på enheten i %s som inte finns i biblioteket.<p>Ta bort böcker som inte finns i biblioteket?"

#: smarteject_plugin.py:140
msgid ""
"There are books on the device in %s that are not in the Library.<p>Display "
"books not in Library?"
msgstr "Det finns böcker på enheten i %s som inte finns i biblioteket.<p>Visa böcker som inte finns i biblioteket?"

#: smarteject_plugin.py:141
msgid "Books on Device not in Library"
msgstr "Böcker på enhet inte i bibliotek"

#: smarteject_plugin.py:158
msgid ""
"There are books in the Library that are not on the Device.<p>Send books not "
"on Device?"
msgstr "Det finns böcker i biblioteket som inte finns på enheten.<p>Skicka böcker som inte finns på enheten?"

#: smarteject_plugin.py:160
msgid ""
"There are books in the Library that are not on the Device.<p>Display books "
"not on Device?"
msgstr "Det finns böcker i biblioteket som inte finns på enheten.<p>Visa böcker som inte finns på enhet?"

#: smarteject_plugin.py:162
msgid "Books in Library not on Device"
msgstr "Böcker i bibliotek inte på enhet"
